import React from "react";

const makeRestaurantImageUrl = (cloudinaryImageId) => {
  if (!cloudinaryImageId)
    return "https://via.placeholder.com/400x300?text=Restaurant";
  if (cloudinaryImageId.startsWith("http")) return cloudinaryImageId;
  return `https://res.cloudinary.com/swiggy/image/upload/${cloudinaryImageId}`;
};

const BodyResCard = ({ resdata }) => {
  return (
    <div className="res-card">
      <img
        className="res-card-image"
        src={makeRestaurantImageUrl(resdata.cloudinaryImageId)}
        alt={resdata.name}
      />

      <div className="res-card-body">
        <h2 className="res-card-title">{resdata.name}</h2>
        <p className="res-card-cuisine">{resdata.cuisines.join(", ")}</p>
        <p className="res-card-meta">
          {resdata.locality} · {resdata.areaName}
        </p>
        <p className="res-card-meta">{resdata.costForTwo}</p>
        <p className="res-card-rating">
          {resdata.avgRating} ★ · {resdata.totalRatings}
        </p>
        <p className="res-card-esimated">{resdata.slaString}</p>
        {resdata.discountHeader && (
          <p className="res-card-discount">
            {resdata.discountHeader} · {resdata.discountSubHeader}
          </p>
        )}
      </div>
    </div>
  );
};

export default BodyResCard;
